<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SebastiansStepRecorder</AssemblyName>
    <RootNamespace>StepRecorder.App</RootNamespace>
    <StartupObject>StepRecorder.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <Version>0.14.0</Version>
    <Product>Sebastians Step Recorder</Product>
    <AssemblyTitle>Sebastians Step Recorder</AssemblyTitle>
    <Copyright>© 2026 Sebedai · MIT-Lizenz</Copyright>
    <!-- Standard win-x64; ARM64: dotnet publish -r win-arm64 (02 §11) – die Angabe auf der Kommandozeile hat Vorrang -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
    <Deterministic>true</Deterministic>
    <!-- WFO0003 (früher WFAC010): DPI-Modus steht bewusst im Manifest (WPF, Per-Monitor v2). WFO2000: Listen mit Texten der Oberflächensprache werden absichtlich je Aufruf neu gebaut. -->
    <NoWarn>$(NoWarn);CA1416;WFAC010;WFO0003;WFO2000</NoWarn>
  </PropertyGroup>

  <!-- Anonyme Ausgabe (siehe Directory.Build.props): eigener Programmname, kein Urheber -->
  <PropertyGroup Condition="'$(Anonymous)' == 'true'">
    <AssemblyName>StepRecorder</AssemblyName>
    <Product>Step Recorder</Product>
    <AssemblyTitle>Step Recorder</AssemblyTitle>
    <Copyright>MIT License</Copyright>
    <ApplicationManifest>app.anonymous.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StepRecorder.Core\StepRecorder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.15" />
    <!-- Fluent-Steuerelemente (Windows 11), MIT-Lizenz – siehe THIRD-PARTY-NOTICES.md -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

</Project>
