<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>StepRecorder</RootNamespace>
    <Version>0.12.0</Version>
    <!-- WFO2000: Listen mit Texten der Oberflächensprache (Loc) werden absichtlich je Aufruf neu gebaut. -->
    <NoWarn>$(NoWarn);CA1416;WFO2000</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="StepRecorder.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/*.md" />
  </ItemGroup>

</Project>
